<% content_for :title, "Unprocessable Entity (422)" %>

<div class="mx-auto max-w-lg px-4 py-20 text-center">
  <p class="text-6xl font-black text-amber-600 dark:text-amber-400">422</p>
  <h1 class="mt-4 text-3xl font-extrabold text-slate-900 dark:text-white">Change Rejected</h1>
  <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
    The change you wanted was rejected. Maybe you tried to change something you didn't have access to.
  </p>
  <div class="mt-6">
    <%= link_to "Return Home", root_path, class: "rounded-xl bg-indigo-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-indigo-700" %>
  </div>
</div>
