<% content_for :title, "Page Not Found (404)" %>

<div class="mx-auto max-w-lg px-4 py-20 text-center">
  <p class="text-6xl font-black text-indigo-600 dark:text-indigo-400">404</p>
  <h1 class="mt-4 text-3xl font-extrabold text-slate-900 dark:text-white">Page Not Found</h1>
  <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
    The discussion, category, or page you were looking for doesn't exist or may have been moved.
  </p>
  <div class="mt-6 flex items-center justify-center gap-3">
    <%= link_to "Back to Home", root_path, class: "rounded-xl bg-indigo-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-indigo-700" %>
    <%= link_to "Search Forum", search_path, class: "rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300" %>
  </div>
</div>
