<% content_for :title, @query.present? ? "Search: #{@query}" : "Search ForumX" %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Search Community</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Find discussions, solutions, members, and topics across ForumX.</p>
  </div>

  <!-- Search Input & Filters Form -->
  <div class="rounded-3xl border border-slate-200/80 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 mb-8">
    <%= form_with url: search_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <svg class="absolute left-3.5 top-3.5 h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <%= f.text_field :q, value: @query, placeholder: "Search keywords, code snippets, questions...", class: "w-full rounded-2xl border border-slate-200 bg-slate-50/50 py-3 pl-11 pr-4 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
        </div>

        <%= f.submit "Search", class: "cursor-pointer rounded-2xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-sm hover:bg-indigo-700 transition shrink-0" %>
      </div>

      <!-- Advanced Filter Row -->
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 pt-2">
        <div>
          <%= f.label :category, "Category", class: "block text-xs font-bold text-slate-500 mb-1" %>
          <%= f.select :category, options_from_collection_for_select(@categories, :slug, :name, @category_slug), { include_blank: "All Categories" }, class: "w-full rounded-xl border border-slate-200 bg-slate-50 py-2 px-3 text-xs text-slate-900 focus:border-indigo-500 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
        </div>

        <div>
          <%= f.label :tag, "Tag", class: "block text-xs font-bold text-slate-500 mb-1" %>
          <%= f.text_field :tag, value: @tag_slug, placeholder: "e.g. ruby", class: "w-full rounded-xl border border-slate-200 bg-slate-50 py-2 px-3 text-xs text-slate-900 focus:border-indigo-500 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
        </div>

        <div>
          <%= f.label :author, "Author Username", class: "block text-xs font-bold text-slate-500 mb-1" %>
          <%= f.text_field :author, value: @author_username, placeholder: "e.g. alex_dev", class: "w-full rounded-xl border border-slate-200 bg-slate-50 py-2 px-3 text-xs text-slate-900 focus:border-indigo-500 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
        </div>

        <div>
          <%= f.label :sort, "Sort By", class: "block text-xs font-bold text-slate-500 mb-1" %>
          <%= f.select :sort, options_for_select([["Relevance", "relevance"], ["Latest", "latest"], ["Trending", "trending"], ["Most Votes", "votes"], ["Most Replies", "replies"], ["Most Viewed", "views"]], @sort_by), {}, class: "w-full rounded-xl border border-slate-200 bg-slate-50 py-2 px-3 text-xs text-slate-900 focus:border-indigo-500 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Search Results Sections -->
  <div class="space-y-8">
    <!-- Matching Categories & Users & Tags if query is present -->
    <% if @query.present? && (@matching_categories.any? || @matching_users.any? || @matching_tags.any?) %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Categories match -->
        <% if @matching_categories.any? %>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <h3 class="font-bold text-xs text-slate-400 uppercase tracking-wider mb-2">Matching Categories</h3>
            <div class="space-y-2">
              <% @matching_categories.each do |cat| %>
                <%= link_to category_path(cat), class: "flex items-center justify-between text-xs font-bold text-indigo-600 hover:underline" do %>
                  <span><%= cat.name %></span>
                  <span class="text-slate-400 font-normal"><%= cat.discussions_count %> posts</span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Users match -->
        <% if @matching_users.any? %>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <h3 class="font-bold text-xs text-slate-400 uppercase tracking-wider mb-2">Matching Members</h3>
            <div class="space-y-2">
              <% @matching_users.each do |u| %>
                <%= link_to user_profile_path(u), class: "flex items-center gap-2 text-xs font-bold text-slate-800 dark:text-slate-200 hover:text-indigo-600" do %>
                  <img src="<%= u.avatar_display_url %>" class="h-5 w-5 rounded-full object-cover">
                  <span>@<%= u.username %></span>
                  <span class="text-amber-600 font-medium">⭐ <%= u.reputation %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Tags match -->
        <% if @matching_tags.any? %>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <h3 class="font-bold text-xs text-slate-400 uppercase tracking-wider mb-2">Matching Tags</h3>
            <div class="flex flex-wrap gap-1">
              <% @matching_tags.each do |t| %>
                <%= link_to tag_path(t), class: "rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400" do %>
                  #<%= t.name %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Discussions Search Results -->
    <div>
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800 mb-4">
        <h2 class="text-base font-bold text-slate-900 dark:text-white">
          Discussions <%= "(#{@discussions.total_count})" if @discussions.respond_to?(:total_count) %>
        </h2>
      </div>

      <div class="space-y-3">
        <% if @discussions.any? %>
          <% @discussions.each do |discussion| %>
            <%= render "discussions/discussion_card", discussion: discussion %>
          <% end %>

          <div class="mt-8 flex justify-center">
            <%= paginate @discussions %>
          </div>
        <% else %>
          <%= render "shared/empty_state",
                     title: "No discussions match '#{@query}'",
                     message: "Try searching with broader terms or removing filter constraints." %>
        <% end %>
      </div>
    </div>
  </div>
</div>
