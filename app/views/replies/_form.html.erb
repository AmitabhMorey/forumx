<% parent_reply_id = local_assigns[:parent_reply_id] %>

<%= form_with model: [discussion, reply], id: (parent_reply_id ? "reply-form-#{parent_reply_id}" : "reply-form"), class: "rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900" do |f| %>
  <%= f.hidden_field :parent_reply_id, value: parent_reply_id %>

  <% if parent_reply_id %>
    <div class="mb-2 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
      <span class="font-medium text-indigo-600 dark:text-indigo-400">Replying to comment thread</span>
      <button type="button" data-action="click->nested-reply#cancel" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">Cancel</button>
    </div>
  <% end %>

  <div class="mb-2">
    <%= f.text_area :body,
                    rows: parent_reply_id ? 3 : 4,
                    placeholder: "Write your constructive response... (Markdown and @mentions supported)",
                    required: true,
                    class: "w-full rounded-xl border border-slate-200 bg-slate-50/50 p-3 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500 dark:border-slate-800 dark:bg-slate-800/40 dark:text-white dark:placeholder-slate-500" %>
  </div>

  <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60">
    <span class="text-xs text-slate-400">Markdown: **bold**, `code`, ```block```, @username</span>
    <div class="flex items-center gap-2">
      <% if parent_reply_id %>
        <button type="button" data-action="click->nested-reply#cancel" class="px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Cancel</button>
      <% end %>
      <%= f.submit (parent_reply_id ? "Post Reply" : "Submit Response"),
                   class: "cursor-pointer rounded-xl bg-indigo-600 px-4 py-1.5 text-xs font-bold text-white shadow-sm hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition" %>
    </div>
  </div>
<% end %>
