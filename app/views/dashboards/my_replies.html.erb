<% content_for :title, "My Replies" %>

<div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">My Replies</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">All responses you have contributed across the platform.</p>
  </div>

  <div class="space-y-4">
    <% if @replies.any? %>
      <% @replies.each do |reply| %>
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="text-xs text-slate-400 mb-2">
            Replied on <%= link_to reply.discussion.title, discussion_path(reply.discussion), class: "font-semibold text-slate-700 hover:text-indigo-600 dark:text-slate-300 dark:hover:text-indigo-400" %>
            • <%= time_ago_in_words(reply.created_at) %> ago
          </div>
          <div class="text-sm text-slate-800 dark:text-slate-200 prose dark:prose-invert max-w-none">
            <%= render_markdown(reply.body) %>
          </div>
          <div class="mt-3 flex items-center gap-2 text-xs text-slate-400">
            <span><%= reply.vote_score %> votes</span>
            <% if reply.is_accepted? %>
              <span class="text-emerald-600 font-bold">• Accepted Answer</span>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="mt-8 flex justify-center">
        <%= paginate @replies %>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: "No replies yet",
                 message: "Browse active discussions and join the conversation.",
                 action_text: "Browse Discussions",
                 action_url: discussions_path %>
    <% end %>
  </div>
</div>
