<% content_for :title, "My Discussions" %>

<div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">My Discussions</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">All discussion topics started by your account.</p>
    </div>
    <%= link_to "New Discussion", new_discussion_path, class: "rounded-xl bg-indigo-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-indigo-700" %>
  </div>

  <div class="space-y-3">
    <% if @discussions.any? %>
      <% @discussions.each do |discussion| %>
        <%= render "discussions/discussion_card", discussion: discussion %>
      <% end %>
      <div class="mt-8 flex justify-center">
        <%= paginate @discussions %>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: "You haven't created any discussions yet",
                 message: "Start a conversation to get help from the community.",
                 action_text: "Start Discussion",
                 action_url: new_discussion_path %>
    <% end %>
  </div>
</div>
