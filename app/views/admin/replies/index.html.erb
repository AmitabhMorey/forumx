<% content_for :title, "Manage Replies" %>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">Reply Moderation</h1>
    <p class="text-sm text-slate-500">Audit, remove, or restore comment replies across all discussions.</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-xs dark:border-slate-800 dark:bg-slate-900">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500 border-b border-slate-200 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-400">
        <tr>
          <th class="px-6 py-3">Comment Preview</th>
          <th class="px-6 py-3">Discussion</th>
          <th class="px-6 py-3">Author</th>
          <th class="px-6 py-3">Status</th>
          <th class="px-6 py-3 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% @replies.each do |reply| %>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
            <td class="px-6 py-4">
              <p class="text-xs text-slate-700 dark:text-slate-300 max-w-sm line-clamp-2">
                <%= reply.body %>
              </p>
              <span class="text-[10px] text-slate-400"><%= time_ago_in_words(reply.created_at) %> ago</span>
            </td>
            <td class="px-6 py-4 text-xs">
              <%= link_to reply.discussion.title, discussion_path(reply.discussion), class: "font-semibold text-slate-800 hover:text-indigo-600 line-clamp-1 max-w-[200px]" %>
            </td>
            <td class="px-6 py-4 text-xs font-bold">
              @<%= reply.user.username %>
            </td>
            <td class="px-6 py-4">
              <span class="rounded px-2 py-0.5 text-xs font-bold capitalize <%= reply.visible? ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                <%= reply.status %>
              </span>
            </td>
            <td class="px-6 py-4 text-right">
              <% if reply.visible? %>
                <%= button_to "Hide", admin_reply_path(reply), method: :delete, data: { turbo_confirm: "Hide this reply?" }, class: "rounded bg-rose-50 px-2.5 py-1 text-xs font-semibold text-rose-600 hover:bg-rose-100" %>
              <% else %>
                <%= button_to "Restore", restore_admin_reply_path(reply), method: :post, class: "rounded bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-600 hover:bg-emerald-100" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="p-4 border-t border-slate-100 dark:border-slate-800 flex justify-center">
      <%= paginate @replies %>
    </div>
  </div>
</div>
