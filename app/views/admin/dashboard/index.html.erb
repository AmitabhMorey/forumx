<% content_for :title, "Dashboard" %>

<div class="space-y-8">
  <div>
    <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">Moderation & Platform Overview</h1>
    <p class="text-sm text-slate-500">Live community health metrics, content activity, and pending review queue.</p>
  </div>

  <!-- KPI Metric Summary Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Members</p>
      <p class="mt-1 text-3xl font-extrabold text-slate-900 dark:text-white"><%= number_with_delimiter(@total_users) %></p>
      <p class="mt-1 text-xs text-emerald-600 font-medium">+<%= @new_users_this_week %> this week</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Discussions</p>
      <p class="mt-1 text-3xl font-extrabold text-slate-900 dark:text-white"><%= number_with_delimiter(@total_discussions) %></p>
      <p class="mt-1 text-xs text-indigo-600 font-medium">+<%= @discussions_this_week %> this week</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Replies</p>
      <p class="mt-1 text-3xl font-extrabold text-slate-900 dark:text-white"><%= number_with_delimiter(@total_replies) %></p>
      <p class="mt-1 text-xs text-indigo-600 font-medium">+<%= @replies_this_week %> this week</p>
    </div>

    <% if @pending_reports_count > 0 %>
      <div class="rounded-2xl border border-rose-300 bg-rose-50/50 dark:border-rose-900 dark:bg-rose-950/30 p-5 shadow-xs">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Pending Reports</p>
        <p class="mt-1 text-3xl font-extrabold text-rose-600"><%= @pending_reports_count %></p>
        <%= link_to "Review queue →", admin_reports_path, class: "mt-1 text-xs font-bold text-rose-600 hover:underline block" %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900 p-5 shadow-xs">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Pending Reports</p>
        <p class="mt-1 text-3xl font-extrabold text-slate-900 dark:text-white"><%= @pending_reports_count %></p>
        <%= link_to "Review queue →", admin_reports_path, class: "mt-1 text-xs font-bold text-slate-500 hover:underline block" %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Pending Reports Queue -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>⚠️ Pending Reports</span>
          <span class="rounded-full bg-rose-100 px-2 py-0.5 text-xs text-rose-700 dark:bg-rose-950 dark:text-rose-300"><%= @pending_reports_count %></span>
        </h2>
        <%= link_to "All Reports", admin_reports_path, class: "text-xs font-semibold text-indigo-600" %>
      </div>

      <div class="mt-4 divide-y divide-slate-100 dark:divide-slate-800">
        <% if @recent_reports.any? %>
          <% @recent_reports.each do |report| %>
            <div class="py-3 flex items-center justify-between gap-4">
              <div class="min-w-0">
                <span class="rounded bg-rose-100 px-2 py-0.5 text-xs font-bold text-rose-700 dark:bg-rose-950 dark:text-rose-300"><%= report.reason %></span>
                <p class="text-xs text-slate-500 mt-1 truncate">
                  Reported by @<%= report.reporter.username %> on <%= report.reportable_type %>
                </p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <%= link_to "Review", admin_report_path(report), class: "rounded-lg bg-slate-100 px-3 py-1 text-xs font-semibold hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700" %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="py-4 text-center text-xs text-slate-400">All caught up! No pending reports in queue.</p>
        <% end %>
      </div>
    </div>

    <!-- Recent Moderation Audit Logs -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
        <h2 class="text-base font-bold text-slate-900 dark:text-white">Recent Audit Logs</h2>
        <%= link_to "All Logs", admin_moderation_logs_path, class: "text-xs font-semibold text-indigo-600" %>
      </div>

      <div class="mt-4 divide-y divide-slate-100 dark:divide-slate-800">
        <% if @recent_moderation_logs.any? %>
          <% @recent_moderation_logs.each do |log| %>
            <div class="py-3 text-xs">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-800 dark:text-slate-200">@<%= log.moderator.username %></span>
                <span class="text-slate-400"><%= time_ago_in_words(log.created_at) %> ago</span>
              </div>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                <span class="font-mono text-indigo-600 font-semibold"><%= log.action_humanized %></span> on <%= log.target_type %> #<%= log.target_id %>
              </p>
              <% if log.reason.present? %>
                <p class="text-[11px] text-slate-400 italic">"<%= log.reason %>"</p>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="py-4 text-center text-xs text-slate-400">No moderation actions recorded yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
