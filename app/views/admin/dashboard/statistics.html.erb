<% content_for :title, "Statistics" %>

<div class="space-y-8">
  <div>
    <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">Analytics & Community Growth</h1>
    <p class="text-sm text-slate-500">30-day activity trends, topic distributions, and moderation breakdown.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Category Distribution -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-base font-bold text-slate-900 dark:text-white mb-4">Discussions by Category</h2>
      <div class="space-y-3">
        <% @category_counts.each do |cat_name, count| %>
          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span><%= cat_name %></span>
              <span class="text-slate-400"><%= count %></span>
            </div>
            <div class="h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div class="h-full bg-indigo-600 rounded-full" style="width: <%= [count * 5, 100].min %>%;"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Reports by Reason -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-base font-bold text-slate-900 dark:text-white mb-4">Report Reasons Breakdown</h2>
      <div class="space-y-3">
        <% @reports_by_reason.each do |reason, count| %>
          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span><%= reason %></span>
              <span class="text-slate-400"><%= count %></span>
            </div>
            <div class="h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div class="h-full bg-rose-500 rounded-full" style="width: <%= [count * 10, 100].min %>%;"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
