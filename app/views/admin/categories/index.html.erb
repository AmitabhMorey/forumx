<% content_for :title, "Manage Categories" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">Category Management</h1>
      <p class="text-sm text-slate-500">Create, edit, reorder, and configure community discussion categories.</p>
    </div>
    <% if current_user.admin? %>
      <%= link_to "Create Category", new_admin_category_path, class: "rounded-xl bg-indigo-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-indigo-700" %>
    <% end %>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-xs dark:border-slate-800 dark:bg-slate-900">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500 border-b border-slate-200 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-400">
        <tr>
          <th class="px-6 py-3">Category</th>
          <th class="px-6 py-3">Slug</th>
          <th class="px-6 py-3">Accent</th>
          <th class="px-6 py-3">Discussions</th>
          <th class="px-6 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% @categories.each do |cat| %>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full" style="background-color: <%= cat.color_accent %>;"></span>
                <span class="font-bold text-slate-900 dark:text-white"><%= cat.name %></span>
              </div>
            </td>
            <td class="px-6 py-4 font-mono text-xs text-slate-500">
              <%= cat.slug %>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                <span class="h-4 w-4 rounded border" style="background-color: <%= cat.color_accent %>;"></span>
                <span class="font-mono text-xs"><%= cat.color_accent %></span>
              </div>
            </td>
            <td class="px-6 py-4 text-xs font-bold">
              <%= cat.discussions_count %>
            </td>
            <td class="px-6 py-4 text-right space-x-2">
              <% if current_user.admin? %>
                <%= link_to "Edit", edit_admin_category_path(cat), class: "rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold hover:bg-slate-200 dark:bg-slate-800" %>
                <%= button_to "Delete", admin_category_path(cat), method: :delete, data: { turbo_confirm: "Delete category #{cat.name}?" }, class: "inline-block rounded-lg text-rose-600 hover:text-rose-700 px-2 py-1 text-xs font-semibold" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
