<%= form_with model: [:admin, category], class: "space-y-4 max-w-xl" do |f| %>
  <% if category.errors.any? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700">
      <ul class="list-disc list-inside">
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
    <%= f.text_field :name, required: true, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 text-sm text-slate-900 focus:border-indigo-500 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
  </div>

  <div>
    <%= f.label :slug, "Slug (optional - auto generated)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
    <%= f.text_field :slug, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 text-sm text-slate-900 focus:border-indigo-500 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 text-sm text-slate-900 focus:border-indigo-500 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :color_accent, "Hex Color Accent", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
      <%= f.text_field :color_accent, placeholder: "#6366f1", class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 text-sm text-slate-900 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
    </div>
    <div>
      <%= f.label :position, "Ordering Position", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
      <%= f.number_field :position, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 text-sm text-slate-900 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
    <%= link_to "Cancel", admin_categories_path, class: "px-4 py-2 text-sm text-slate-500" %>
    <%= f.submit (category.persisted? ? "Update Category" : "Create Category"), class: "rounded-xl bg-indigo-600 px-5 py-2 text-sm font-bold text-white hover:bg-indigo-700 cursor-pointer" %>
  </div>
<% end %>
