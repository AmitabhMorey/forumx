<% content_for :title, "Manage @#{@user.username}" %>

<div class="space-y-6 max-w-4xl">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">User: @<%= @user.username %></h1>
      <p class="text-sm text-slate-500"><%= @user.email %> • Joined <%= @user.created_at.strftime("%B %d, %Y") %></p>
    </div>
    <%= link_to "← All Users", admin_users_path, class: "text-xs font-semibold text-slate-500 hover:text-slate-900 dark:hover:text-white" %>
  </div>

  <!-- Moderation / Role Action Card -->
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-base font-bold text-slate-900 dark:text-white mb-4">Account Administration</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Role Management (Admin only) -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Modify Platform Role</h3>
        <% if current_user.admin? %>
          <%= form_with url: update_role_admin_user_path(@user), method: :post, class: "flex items-center gap-2" do |f| %>
            <%= f.select :role, [["User", "user"], ["Moderator", "moderator"], ["Admin", "admin"]], { selected: @user.role }, class: "rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs text-slate-900 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
            <%= f.submit "Update Role", class: "cursor-pointer rounded-xl bg-indigo-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-indigo-700" %>
          <% end %>
        <% else %>
          <p class="text-xs text-slate-500">Only platform administrators can modify user roles.</p>
        <% end %>
      </div>

      <!-- Suspension Controls -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Account Status & Suspension</h3>
        <% if @user.suspended? %>
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-rose-600">Currently Suspended</span>
            <%= button_to "Lift Suspension", unsuspend_admin_user_path(@user), method: :post, class: "rounded-xl bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-emerald-700" %>
          </div>
        <% else %>
          <%= form_with url: suspend_admin_user_path(@user), method: :post, class: "space-y-2" do |f| %>
            <%= f.text_field :reason, placeholder: "Reason for suspension...", class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs text-slate-900 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
            <%= f.submit "Suspend Account", data: { turbo_confirm: "Are you sure you want to suspend this user?" }, class: "cursor-pointer rounded-xl bg-rose-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-rose-700" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- User Moderation History -->
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-base font-bold text-slate-900 dark:text-white mb-4">Audit History on this User</h2>
    <div class="divide-y divide-slate-100 dark:divide-slate-800">
      <% if @moderation_logs.any? %>
        <% @moderation_logs.each do |log| %>
          <div class="py-2.5 text-xs flex items-center justify-between">
            <div>
              <span class="font-bold text-slate-800 dark:text-slate-200">@<%= log.moderator.username %>:</span>
              <span class="font-mono text-indigo-600 font-semibold"><%= log.action_humanized %></span>
              <% if log.reason.present? %>
                <span class="text-slate-400 italic">("<%= log.reason %>")</span>
              <% end %>
            </div>
            <span class="text-slate-400"><%= time_ago_in_words(log.created_at) %> ago</span>
          </div>
        <% end %>
      <% else %>
        <p class="text-xs text-slate-400 py-2">No moderation actions recorded for this user.</p>
      <% end %>
    </div>
  </div>
</div>
