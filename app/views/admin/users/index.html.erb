<% content_for :title, "Manage Users" %>

<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">User Management</h1>
      <p class="text-sm text-slate-500">Search members, modify permissions, and administer account suspensions.</p>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900">
    <%= form_with url: admin_users_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <div class="flex-1">
        <%= f.text_field :q, value: params[:q], placeholder: "Search by username, email, or name...", class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
      </div>

      <div class="w-40">
        <%= f.select :role, [["All Roles", ""], ["User", "user"], ["Moderator", "moderator"], ["Admin", "admin"]], { selected: params[:role] }, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
      </div>

      <div class="w-40">
        <%= f.select :status, [["All Statuses", ""], ["Active", "active"], ["Suspended", "suspended"]], { selected: params[:status] }, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 dark:border-slate-800 dark:bg-slate-800 dark:text-white" %>
      </div>

      <%= f.submit "Filter", class: "cursor-pointer rounded-xl bg-indigo-600 px-5 py-2 text-sm font-bold text-white hover:bg-indigo-700" %>
    <% end %>
  </div>

  <!-- Users Table -->
  <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-xs dark:border-slate-800 dark:bg-slate-900">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500 border-b border-slate-200 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-400">
          <tr>
            <th class="px-6 py-3">Member</th>
            <th class="px-6 py-3">Role</th>
            <th class="px-6 py-3">Reputation</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3">Joined</th>
            <th class="px-6 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% @users.each do |user| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <img src="<%= user.avatar_display_url %>" class="h-8 w-8 rounded-full object-cover">
                  <div>
                    <p class="font-bold text-slate-900 dark:text-white">@<%= user.username %></p>
                    <p class="text-xs text-slate-400"><%= user.email %></p>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <% if user.admin? %>
                  <span class="rounded-md px-2 py-0.5 text-xs font-bold uppercase bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                    <%= user.role %>
                  </span>
                <% elsif user.moderator? %>
                  <span class="rounded-md px-2 py-0.5 text-xs font-bold uppercase bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300">
                    <%= user.role %>
                  </span>
                <% else %>
                  <span class="rounded-md px-2 py-0.5 text-xs font-bold uppercase bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    <%= user.role %>
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 font-mono font-bold text-amber-600 dark:text-amber-400">
                ⭐ <%= user.reputation %>
              </td>
              <td class="px-6 py-4">
                <% if user.suspended? %>
                  <span class="rounded-md bg-rose-100 px-2 py-0.5 text-xs font-bold text-rose-700 dark:bg-rose-950 dark:text-rose-300">Suspended</span>
                <% else %>
                  <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">Active</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-xs text-slate-500">
                <%= user.created_at.strftime("%b %d, %Y") %>
              </td>
              <td class="px-6 py-4 text-right">
                <%= link_to "Manage", admin_user_path(user), class: "rounded-lg bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="p-4 border-t border-slate-100 dark:border-slate-800 flex justify-center">
      <%= paginate @users %>
    </div>
  </div>
</div>
