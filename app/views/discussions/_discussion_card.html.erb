<div class="card-glass relative flex items-start gap-4 rounded-2xl p-5 group transition-all duration-200">
  <!-- Voting Column -->
  <div class="hidden sm:block shrink-0">
    <%= render "discussions/vote_controls", voteable: discussion %>
  </div>

  <!-- Content Column -->
  <div class="flex-1 min-w-0">
    <!-- Header: Category, Status Badges, Author -->
    <div class="flex flex-wrap items-center gap-2 text-xs mb-2.5">
      <!-- Category Badge -->
      <%= link_to category_path(discussion.category), class: "inline-flex items-center gap-1.5 rounded-md px-2.5 py-0.5 font-semibold text-xs transition border border-white/5 hover:border-white/15", style: "background-color: #{discussion.category.color_accent}12; color: #{discussion.category.color_accent};" do %>
        <span class="h-1.5 w-1.5 rounded-full" style="background-color: <%= discussion.category.color_accent %>; box-shadow: 0 0 6px <%= discussion.category.color_accent %>;"></span>
        <%= discussion.category.name %>
      <% end %>

      <!-- Pinned Badge -->
      <% if discussion.pinned? %>
        <span class="inline-flex items-center gap-1 rounded-md bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-400 border border-amber-500/20">
          <svg class="h-3 w-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/></svg>
          Pinned
        </span>
      <% end %>

      <!-- Locked Badge -->
      <% if discussion.locked? %>
        <span class="inline-flex items-center gap-1 rounded-md bg-zinc-800/80 px-2 py-0.5 text-xs font-semibold text-zinc-400 border border-white/5">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Locked
        </span>
      <% end %>

      <!-- Resolved Badge -->
      <% if discussion.resolved? %>
        <span class="inline-flex items-center gap-1 rounded-md bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-400 border border-emerald-500/25">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Solved
        </span>
      <% end %>

      <span class="text-zinc-600">•</span>
      <span class="text-zinc-400">posted <%= time_ago_in_words(discussion.created_at) %> ago</span>
      <span class="text-zinc-600">by</span>
      <%= link_to "@#{discussion.user.username}", user_profile_path(discussion.user), class: "font-semibold text-zinc-300 hover:text-indigo-400 transition" %>
    </div>

    <!-- Title -->
    <h2 class="text-base sm:text-lg font-bold text-white leading-snug tracking-tight">
      <%= link_to discussion.title, discussion_path(discussion), class: "group-hover:text-indigo-300 transition" %>
    </h2>

    <!-- Body Preview -->
    <p class="mt-1.5 text-xs sm:text-sm text-zinc-400 line-clamp-2 leading-relaxed">
      <%= truncate(strip_tags(discussion.body), length: 180) %>
    </p>

    <!-- Footer: Tags & Metrics -->
    <div class="mt-3.5 flex flex-wrap items-center justify-between gap-3 pt-2.5 border-t border-white/6">
      <!-- Tags -->
      <div class="flex flex-wrap items-center gap-1.5">
        <% discussion.tags.each do |tag| %>
          <%= link_to tag_path(tag), class: "inline-flex items-center rounded-md bg-zinc-800/60 px-2 py-0.5 text-[11px] font-mono text-zinc-400 hover:text-white border border-white/5 hover:border-white/15 transition" do %>
            #<%= tag.name %>
          <% end %>
        <% end %>
      </div>

      <!-- Stats: Replies, Views, Mobile Score -->
      <div class="flex items-center gap-4 text-xs font-mono font-medium text-zinc-400">
        <div class="sm:hidden flex items-center gap-1">
          <svg class="h-3.5 w-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
          <span><%= discussion.vote_score %></span>
        </div>

        <div class="flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          <span><%= pluralize(discussion.reply_count, "reply") %></span>
        </div>

        <div class="flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          <span><%= discussion.view_count %> views</span>
        </div>
      </div>
    </div>
  </div>
</div>
