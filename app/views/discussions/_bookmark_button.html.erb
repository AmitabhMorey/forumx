<% is_bookmarked = local_assigns[:is_bookmarked] || (current_user ? current_user.bookmarked?(discussion) : false) %>

<div id="<%= dom_id(discussion, :bookmark_btn) %>" class="inline-block">
  <% if user_signed_in? %>
    <%= button_to bookmark_discussion_path(discussion),
                  method: :post,
                  class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-semibold transition #{is_bookmarked ? 'border-amber-300 bg-amber-50 text-amber-800 dark:bg-amber-950/40 dark:border-amber-800 dark:text-amber-300' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'}" do %>
      <svg class="h-4 w-4 <%= is_bookmarked ? 'fill-amber-500 text-amber-500' : 'text-slate-400' %>" fill="<%= is_bookmarked ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
      </svg>
      <span><%= is_bookmarked ? "Bookmarked" : "Bookmark" %></span>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 transition" do %>
      <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
      </svg>
      <span>Bookmark</span>
    <% end %>
  <% end %>
</div>
