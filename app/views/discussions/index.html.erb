<% content_for :title, "Discussions" %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Community Discussions</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Discover questions, answers, and technical ideas from the community.</p>
    </div>

    <%= link_to new_discussion_path, class: "inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition self-start" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
      <span>New Discussion</span>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Main Discussions Column -->
    <div class="lg:col-span-3 space-y-6">
      <!-- Sorting Bar -->
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <div class="flex items-center gap-2 overflow-x-auto text-sm font-medium">
          <%= link_to "Trending", discussions_path(sort: "trending", category: params[:category], tag: params[:tag]), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'trending' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
          <%= link_to "Latest", discussions_path(sort: "latest", category: params[:category], tag: params[:tag]), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'latest' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
          <%= link_to "Most Votes", discussions_path(sort: "votes", category: params[:category], tag: params[:tag]), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'votes' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
          <%= link_to "Most Replies", discussions_path(sort: "replies", category: params[:category], tag: params[:tag]), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'replies' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
          <%= link_to "Most Viewed", discussions_path(sort: "views", category: params[:category], tag: params[:tag]), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'views' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
        </div>

        <% if params[:category].present? || params[:tag].present? %>
          <%= link_to "Clear filters", discussions_path, class: "text-xs font-semibold text-rose-500 hover:underline" %>
        <% end %>
      </div>

      <!-- Discussions List -->
      <div class="space-y-3">
        <% if @discussions.any? %>
          <% @discussions.each do |discussion| %>
            <%= render "discussions/discussion_card", discussion: discussion %>
          <% end %>

          <!-- Pagination -->
          <div class="mt-8 flex justify-center">
            <%= paginate @discussions %>
          </div>
        <% else %>
          <%= render "shared/empty_state",
                     title: "No discussions match your filter",
                     message: "Try selecting a different sort option or clear your filters.",
                     action_text: "Clear Filters",
                     action_url: discussions_path %>
        <% end %>
      </div>
    </div>

    <!-- Sidebar Filters -->
    <div class="space-y-6">
      <!-- Filter by Category -->
      <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h3 class="font-bold text-sm text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800">Categories</h3>
        <div class="mt-3 space-y-1">
          <%= link_to "All Categories", discussions_path(sort: @sort), class: "flex items-center justify-between p-2 rounded-xl text-sm transition #{params[:category].blank? ? 'bg-indigo-50 font-bold text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-400' : 'text-slate-600 hover:bg-slate-50 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
          <% @categories.each do |cat| %>
            <%= link_to discussions_path(category: cat.slug, sort: @sort), class: "flex items-center justify-between p-2 rounded-xl text-sm transition #{params[:category] == cat.slug ? 'bg-indigo-50 font-bold text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-400' : 'text-slate-600 hover:bg-slate-50 dark:text-slate-400 dark:hover:bg-slate-800'}" do %>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full" style="background-color: <%= cat.color_accent %>;"></span>
                <span><%= cat.name %></span>
              </div>
              <span class="text-xs text-slate-400"><%= cat.discussions_count %></span>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Popular Tags -->
      <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h3 class="font-bold text-sm text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800">Popular Tags</h3>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <% @popular_tags.each do |tag| %>
            <%= link_to tag_path(tag), class: "inline-flex items-center gap-1 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-indigo-950/40 dark:hover:text-indigo-400 transition #{'ring-1 ring-indigo-500 text-indigo-600' if params[:tag] == tag.slug}" do %>
              <span>#<%= tag.name %></span>
              <span class="text-[10px] opacity-60">(<%= tag.discussions_count %>)</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
