<header class="sticky top-0 z-40 w-full border-b border-white/8 bg-[#09090b]/80 backdrop-blur-xl transition-all" data-controller="mobile-menu">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand & Left Navigation -->
    <div class="flex items-center gap-8">
      <%= link_to root_path, class: "flex items-center gap-3 group" do %>
        <div class="relative flex h-9 w-9 items-center justify-center rounded-xl bg-zinc-900 border border-white/10 text-indigo-400 shadow-inner group-hover:border-indigo-500/50 group-hover:text-indigo-300 transition">
          <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-extrabold text-lg tracking-tight text-white">FORUM<span class="text-indigo-400">X</span></span>
          <span class="flex h-1.5 w-1.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
          </span>
        </div>
      <% end %>

      <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-zinc-400">
        <%= link_to "Feed", root_path, class: "px-3 py-1.5 rounded-lg hover:text-white hover:bg-white/5 transition #{'text-white bg-white/8' if current_page?(root_path)}" %>
        <%= link_to "Discussions", discussions_path, class: "px-3 py-1.5 rounded-lg hover:text-white hover:bg-white/5 transition #{'text-white bg-white/8' if current_page?(discussions_path)}" %>
        <%= link_to "Categories", categories_path, class: "px-3 py-1.5 rounded-lg hover:text-white hover:bg-white/5 transition #{'text-white bg-white/8' if current_page?(categories_path)}" %>
      </nav>
    </div>

    <!-- Center Command Search Bar (Desktop) -->
    <div class="hidden md:flex flex-1 max-w-md mx-6">
      <%= form_with url: search_path, method: :get, class: "w-full relative group", local: true do |f| %>
        <div class="relative flex items-center">
          <svg class="absolute left-3.5 h-4 w-4 text-zinc-500 group-focus-within:text-indigo-400 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <%= f.text_field :q, value: params[:q], placeholder: "Search topics, code, members...", class: "w-full rounded-xl border border-white/8 bg-zinc-900/60 py-1.5 pl-10 pr-12 text-sm text-zinc-100 placeholder-zinc-500 focus:border-indigo-500/60 focus:bg-zinc-900 focus:outline-none focus:ring-1 focus:ring-indigo-500/40 transition backdrop-blur-md" %>
          <div class="absolute right-3 flex items-center gap-0.5 pointer-events-none">
            <kbd class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-zinc-800 border border-white/10 text-zinc-400">⌘K</kbd>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <% if user_signed_in? %>
        <!-- Notifications Bell -->
        <%= link_to notifications_path, class: "relative p-2 text-zinc-400 hover:text-white hover:bg-white/[0.05] rounded-xl transition", aria: { label: "Notifications" } do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <% if @unread_notifications_count.to_i > 0 %>
            <span class="absolute top-1 right-1 flex h-4 w-4 items-center justify-center rounded-full bg-rose-500 text-[10px] font-bold text-white shadow-sm ring-2 ring-[#09090b]">
              <%= @unread_notifications_count > 9 ? "9+" : @unread_notifications_count %>
            </span>
          <% end %>
        <% end %>

        <!-- New Discussion Button (Shimmer) -->
        <%= link_to new_discussion_path, class: "btn-shimmer hidden sm:inline-flex items-center gap-2 rounded-xl px-3.5 py-1.5 text-xs font-bold text-white shadow-sm hover:border-white/20 transition" do %>
          <svg class="h-3.5 w-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
          </svg>
          <span>New Discussion</span>
        <% end %>

        <!-- User Profile Dropdown -->
        <div class="relative" data-controller="dropdown">
          <button type="button" data-action="click->dropdown#toggle" class="flex items-center gap-2 rounded-full focus:outline-none focus:ring-2 focus:ring-indigo-500/50 p-0.5 border border-white/10 hover:border-white/25 transition" id="user-menu-button" aria-expanded="false" aria-haspopup="true">
            <img class="h-8 w-8 rounded-full object-cover" src="<%= current_user.avatar_display_url %>" alt="<%= current_user.username %>">
          </button>

          <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-60 origin-top-right rounded-2xl bg-zinc-900/95 backdrop-blur-xl p-1.5 shadow-2xl border border-white/10 focus:outline-none z-50">
            <div class="px-3 py-2.5 border-b border-white/8">
              <p class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider">Signed in as</p>
              <p class="text-sm font-bold text-white truncate">@<%= current_user.username %></p>
              <div class="mt-1 flex items-center gap-2 text-xs font-medium">
                <span class="text-amber-400 font-mono">⭐ <%= current_user.reputation %> rep</span>
                <span class="text-zinc-600">•</span>
                <span class="text-xs px-1.5 py-0.2 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 uppercase tracking-wider text-[10px] font-bold"><%= current_user.role %></span>
              </div>
            </div>

            <div class="py-1">
              <%= link_to dashboard_path, class: "flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-zinc-300 hover:bg-white/6 hover:text-white rounded-xl transition" do %>
                <svg class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                Dashboard
              <% end %>
              <%= link_to user_profile_path(current_user), class: "flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-zinc-300 hover:bg-white/6 hover:text-white rounded-xl transition" do %>
                <svg class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                Public Profile
              <% end %>
              <%= link_to bookmarks_path, class: "flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-zinc-300 hover:bg-white/6 hover:text-white rounded-xl transition" do %>
                <svg class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                Saved Bookmarks
              <% end %>
              <%= link_to my_discussions_path, class: "flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-zinc-300 hover:bg-white/6 hover:text-white rounded-xl transition" do %>
                <svg class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                My Discussions
              <% end %>
              <%= link_to edit_profile_path, class: "flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-zinc-300 hover:bg-white/6 hover:text-white rounded-xl transition" do %>
                <svg class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Account Settings
              <% end %>
            </div>

            <% if current_user.can_moderate? %>
              <div class="py-1 border-t border-white/8">
                <%= link_to admin_root_path, class: "flex items-center gap-2.5 px-3 py-2 text-xs font-bold text-indigo-400 hover:bg-indigo-500/10 rounded-xl transition" do %>
                  <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  Admin Center
                <% end %>
              </div>
            <% end %>

            <div class="py-1 border-t border-white/8">
              <%= button_to destroy_user_session_path, method: :delete, class: "w-full text-left flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-rose-400 hover:bg-rose-500/10 rounded-xl transition" do %>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                Sign out
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <%= link_to "Sign In", new_user_session_path, class: "px-3.5 py-1.5 text-xs font-semibold text-zinc-300 hover:text-white hover:bg-white/5 rounded-xl transition" %>
        <div class="glow-border-wrapper rounded-xl">
          <%= link_to "Sign Up", new_user_registration_path, class: "relative z-10 rounded-xl bg-zinc-950 px-4 py-1.5 text-xs font-bold text-white border border-white/10 hover:bg-zinc-900 transition flex items-center gap-1.5" %>
        </div>
      <% end %>

      <!-- Mobile Menu Hamburger Button -->
      <button type="button" data-action="click->mobile-menu#open" class="md:hidden p-2 text-zinc-400 hover:text-white hover:bg-white/5 rounded-xl transition" aria-label="Open Navigation Menu">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div data-mobile-menu-target="drawer" class="hidden fixed inset-0 z-50 md:hidden" role="dialog" aria-modal="true">
    <!-- Backdrop -->
    <div data-action="click->mobile-menu#close" class="fixed inset-0 bg-black/70 backdrop-blur-md transition-opacity"></div>

    <!-- Drawer Panel -->
    <div class="relative ml-auto flex h-full w-full max-w-xs flex-col bg-[#0d0e12] border-l border-white/10 p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-5 border-b border-white/8">
        <span class="font-extrabold text-lg text-white">FORUM<span class="text-indigo-400">X</span></span>
        <button type="button" data-action="click->mobile-menu#close" class="p-1.5 text-zinc-400 hover:text-white hover:bg-white/10 rounded-lg">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="mt-4 mb-6">
        <%= form_with url: search_path, method: :get, local: true do |f| %>
          <%= f.text_field :q, value: params[:q], placeholder: "Search forum...", class: "w-full rounded-xl border border-white/10 bg-zinc-900 py-2 px-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-indigo-500" %>
        <% end %>
      </div>

      <nav class="flex flex-col gap-1.5 text-sm font-medium text-zinc-300">
        <%= link_to "Home", root_path, class: "px-3 py-2 rounded-xl hover:bg-white/5" %>
        <%= link_to "Discussions", discussions_path, class: "px-3 py-2 rounded-xl hover:bg-white/5" %>
        <%= link_to "Categories", categories_path, class: "px-3 py-2 rounded-xl hover:bg-white/5" %>
        <% if user_signed_in? %>
          <div class="my-2 border-t border-white/8"></div>
          <%= link_to "New Discussion", new_discussion_path, class: "px-3 py-2 rounded-xl font-bold text-indigo-400 bg-indigo-500/10 border border-indigo-500/20" %>
          <%= link_to "Saved Bookmarks", bookmarks_path, class: "px-3 py-2 rounded-xl hover:bg-white/5" %>
          <%= link_to "Notifications", notifications_path, class: "px-3 py-2 rounded-xl hover:bg-white/5" %>
          <%= link_to "Dashboard", dashboard_path, class: "px-3 py-2 rounded-xl hover:bg-white/5" %>
          <%= link_to "Public Profile", user_profile_path(current_user), class: "px-3 py-2 rounded-xl hover:bg-white/5" %>
          <% if current_user.can_moderate? %>
            <%= link_to "Admin Center", admin_root_path, class: "px-3 py-2 rounded-xl text-amber-400 hover:bg-white/5" %>
          <% end %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "w-full text-left px-3 py-2 rounded-xl text-rose-400 hover:bg-rose-500/10" %>
        <% else %>
          <div class="pt-4 mt-4 border-t border-white/8 flex flex-col gap-2">
            <%= link_to "Sign In", new_user_session_path, class: "w-full text-center py-2 px-4 rounded-xl border border-white/10 font-semibold text-zinc-300 hover:bg-white/5" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "w-full text-center py-2 px-4 rounded-xl bg-indigo-600 text-white font-bold hover:bg-indigo-500" %>
          </div>
        <% end %>
      </nav>
    </div>
  </div>
</header>
