<div id="flash-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2.5 max-w-md w-full px-4 pointer-events-none">
  <% flash.each do |type, message| %>
    <% next if message.blank? %>
    <% is_alert = type.to_s == "alert" || type.to_s == "error" %>
    <% if is_alert %>
      <div data-controller="flash"
           class="pointer-events-auto flex items-center justify-between p-4 rounded-2xl shadow-2xl border border-rose-500/30 border-l-4 border-l-rose-500 bg-zinc-900/95 backdrop-blur-xl transition-all duration-300"
           role="alert">
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-rose-500/15 text-rose-400 shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <p class="text-xs sm:text-sm font-semibold text-zinc-200"><%= message %></p>
        </div>
        <button type="button" data-action="click->flash#dismiss" class="text-zinc-500 hover:text-white p-1 rounded-lg hover:bg-white/10 transition" aria-label="Dismiss">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    <% else %>
      <div data-controller="flash"
           class="pointer-events-auto flex items-center justify-between p-4 rounded-2xl shadow-2xl border border-emerald-500/30 border-l-4 border-l-emerald-500 bg-zinc-900/95 backdrop-blur-xl transition-all duration-300"
           role="alert">
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400 shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-xs sm:text-sm font-semibold text-zinc-200"><%= message %></p>
        </div>
        <button type="button" data-action="click->flash#dismiss" class="text-zinc-500 hover:text-white p-1 rounded-lg hover:bg-white/10 transition" aria-label="Dismiss">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    <% end %>
  <% end %>
</div>
