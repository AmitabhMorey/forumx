<% title = local_assigns[:title] || "No items found" %>
<% message = local_assigns[:message] || "There is nothing to display here yet." %>
<% action_text = local_assigns[:action_text] %>
<% action_url = local_assigns[:action_url] %>

<div class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-white/60 p-12 text-center dark:border-slate-800 dark:bg-slate-900/40">
  <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400 dark:bg-slate-800 dark:text-slate-500">
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
    </svg>
  </div>
  <h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white"><%= title %></h3>
  <p class="mt-1 max-w-sm text-sm text-slate-500 dark:text-slate-400"><%= message %></p>
  <% if action_text.present? && action_url.present? %>
    <div class="mt-6">
      <%= link_to action_text, action_url, class: "inline-flex items-center rounded-xl bg-indigo-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-indigo-700 transition" %>
    </div>
  <% end %>
</div>
