<% content_for :title, "Reset Password" %>

<div class="mx-auto max-w-md px-4 py-16 sm:py-24">
  <div class="card-glass relative overflow-hidden rounded-3xl p-8 sm:p-10 border border-white/10 shadow-2xl">
    <div class="absolute top-0 inset-x-0 h-0.5 bg-linear-to-r from-transparent via-indigo-500 to-transparent"></div>

    <div class="text-center mb-8">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-zinc-900 border border-white/15 text-indigo-400 shadow-inner mb-3">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
      </div>
      <h1 class="text-2xl font-extrabold tracking-tight text-white">Reset Password</h1>
      <p class="mt-1.5 text-xs text-zinc-400">Enter your email to receive recovery instructions</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "Account Email", class: "block text-xs font-mono font-semibold text-zinc-300 mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "developer@example.com", class: "w-full rounded-xl border border-white/10 bg-zinc-900/90 px-4 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-indigo-500/70 focus:bg-zinc-900 focus:outline-none focus:ring-1 focus:ring-indigo-500/40 transition" %>
      </div>

      <div class="pt-2">
        <div class="glow-border-wrapper w-full rounded-xl">
          <%= f.submit "Send Reset Instructions", class: "relative z-10 w-full cursor-pointer rounded-xl bg-zinc-950 py-3 text-sm font-bold text-white border border-white/15 hover:bg-zinc-900 transition flex items-center justify-center gap-2 shadow-lg" %>
        </div>
      </div>
    <% end %>

    <div class="mt-8 pt-6 border-t border-white/8 text-center text-xs text-zinc-400">
      Remembered your password?
      <%= link_to "Sign In →", new_session_path(resource_name), class: "font-bold text-indigo-400 hover:text-indigo-300 ml-1 transition" %>
    </div>
  </div>
</div>
