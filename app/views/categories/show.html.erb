<% content_for :title, @category.name %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <!-- Category Header Card -->
  <div class="rounded-3xl border border-slate-200/80 bg-white p-6 sm:p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900 mb-8 relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-2" style="background-color: <%= @category.color_accent %>;"></div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span class="inline-flex items-center justify-center h-9 w-9 rounded-xl font-bold text-base" style="background-color: <%= @category.color_accent %>20; color: <%= @category.color_accent %>;">
            #
          </span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white"><%= @category.name %></h1>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-2xl">
          <%= @category.description %>
        </p>
        <div class="mt-3 flex items-center gap-3 text-xs font-semibold text-slate-500">
          <span><%= pluralize(@category.discussions_count, "Discussion") %></span>
        </div>
      </div>

      <%= link_to new_discussion_path(category_id: @category.id), class: "inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition self-start" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
        <span>Ask in <%= @category.name %></span>
      <% end %>
    </div>
  </div>

  <!-- Sorting Filter Tabs -->
  <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3 mb-6">
    <div class="flex items-center gap-2 overflow-x-auto text-sm font-medium">
      <%= link_to "Latest", category_path(@category, sort: "latest"), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'latest' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
      <%= link_to "Trending", category_path(@category, sort: "trending"), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'trending' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
      <%= link_to "Most Votes", category_path(@category, sort: "votes"), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'votes' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
      <%= link_to "Most Replies", category_path(@category, sort: "replies"), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'replies' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
      <%= link_to "Most Viewed", category_path(@category, sort: "views"), class: "px-3 py-1.5 rounded-lg transition #{@sort == 'views' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
    </div>
  </div>

  <!-- Discussion List -->
  <div class="space-y-4">
    <% if @discussions.any? %>
      <% @discussions.each do |discussion| %>
        <%= render "discussions/discussion_card", discussion: discussion %>
      <% end %>

      <!-- Pagination -->
      <div class="mt-8 flex justify-center">
        <%= paginate @discussions %>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: "No discussions in #{@category.name} yet",
                 message: "Start the very first conversation in this category!",
                 action_text: "Create Discussion",
                 action_url: new_discussion_path(category_id: @category.id) %>
    <% end %>
  </div>
</div>
