<% content_for :title, "Tag: ##{@tag.name}" %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-8 rounded-3xl border border-slate-200/80 bg-white p-6 sm:p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 font-mono text-xl font-bold text-indigo-600 dark:bg-indigo-950 dark:text-indigo-400">
        #
      </span>
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">#<%= @tag.name %></h1>
        <p class="text-xs text-slate-500"><%= pluralize(@tag.discussions_count, "discussion") %> tagged with this topic</p>
      </div>
    </div>
  </div>

  <div class="space-y-3">
    <% if @discussions.any? %>
      <% @discussions.each do |discussion| %>
        <%= render "discussions/discussion_card", discussion: discussion %>
      <% end %>

      <div class="mt-8 flex justify-center">
        <%= paginate @discussions %>
      </div>
    <% else %>
      <%= render "shared/empty_state", title: "No discussions with this tag", message: "Discussions tagged with ##{@tag.name} will appear here." %>
    <% end %>
  </div>
</div>
