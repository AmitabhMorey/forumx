<% content_for :title, "Notifications" %>

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">Notifications</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Activity on your discussions, replies, and @mentions.</p>
    </div>

    <% if current_user.received_notifications.unread.any? %>
      <%= button_to mark_all_read_notifications_path, method: :post, class: "rounded-xl border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" do %>
        Mark all as read
      <% end %>
    <% end %>
  </div>

  <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-3 mb-6 text-sm font-medium">
    <%= link_to "All", notifications_path, class: "px-3 py-1.5 rounded-lg transition #{params[:filter] != 'unread' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
    <%= link_to "Unread (#{current_user.received_notifications.unread.count})", notifications_path(filter: "unread"), class: "px-3 py-1.5 rounded-lg transition #{params[:filter] == 'unread' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800'}" %>
  </div>

  <div class="space-y-3">
    <% if @notifications.any? %>
      <% @notifications.each do |notification| %>
        <% card_classes = notification.read? ? "border-slate-200/80 bg-white dark:border-slate-800 dark:bg-slate-900 opacity-80" : "border-indigo-200 bg-indigo-50/40 dark:border-indigo-900/60 dark:bg-indigo-950/20" %>
        <%= tag.div id: dom_id(notification), class: "flex items-center justify-between p-4 rounded-2xl border transition #{card_classes}" do %>
          <div class="flex items-center gap-3 min-w-0">
            <img src="<%= notification.actor.avatar_display_url %>" alt="<%= notification.actor.username %>" class="h-10 w-10 rounded-full object-cover shrink-0">
            <div class="min-w-0">
              <p class="text-sm font-medium text-slate-900 dark:text-white leading-snug">
                <%= notification.message_preview %>
              </p>
              <div class="mt-1 flex items-center gap-2 text-xs text-slate-400">
                <span><%= time_ago_in_words(notification.created_at) %> ago</span>
                <% if notification.notifiable.is_a?(Discussion) %>
                  <span>•</span>
                  <%= link_to "View Discussion", discussion_path(notification.notifiable), class: "font-semibold text-indigo-600 hover:underline" %>
                <% elsif notification.notifiable.is_a?(Reply) %>
                  <span>•</span>
                  <%= link_to "View Reply", discussion_path(notification.notifiable.discussion, anchor: "reply-#{notification.notifiable.id}"), class: "font-semibold text-indigo-600 hover:underline" %>
                <% end %>
              </div>
            </div>
          </div>

          <div>
            <% unless notification.read? %>
              <%= button_to notification_path(notification), method: :patch, class: "p-1.5 text-slate-400 hover:text-indigo-600 rounded-lg hover:bg-white dark:hover:bg-slate-800 transition", title: "Mark as read" do %>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <div class="mt-8 flex justify-center">
        <%= paginate @notifications %>
      </div>
    <% else %>
      <%= render "shared/empty_state", title: "No notifications", message: "You're all caught up! New mentions, replies, and badges will appear here." %>
    <% end %>
  </div>
</div>
