<%= turbo_stream.replace dom_id(@notification) do %>
  <div id="<%= dom_id(@notification) %>" class="flex items-center justify-between p-4 rounded-2xl border border-slate-200/80 bg-white dark:border-slate-800 dark:bg-slate-900 opacity-80">
    <div class="flex items-center gap-3 min-w-0">
      <img src="<%= @notification.actor.avatar_display_url %>" alt="<%= @notification.actor.username %>" class="h-10 w-10 rounded-full object-cover shrink-0">
      <div class="min-w-0">
        <p class="text-sm font-medium text-slate-900 dark:text-white leading-snug">
          <%= @notification.message_preview %>
        </p>
        <div class="mt-1 flex items-center gap-2 text-xs text-slate-400">
          <span><%= time_ago_in_words(@notification.created_at) %> ago</span>
          <% if @notification.notifiable.is_a?(Discussion) %>
            <span>•</span>
            <%= link_to "View Discussion", discussion_path(@notification.notifiable), class: "font-semibold text-indigo-600 hover:underline" %>
          <% elsif @notification.notifiable.is_a?(Reply) %>
            <span>•</span>
            <%= link_to "View Reply", discussion_path(@notification.notifiable.discussion, anchor: "reply-#{@notification.notifiable.id}"), class: "font-semibold text-indigo-600 hover:underline" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
